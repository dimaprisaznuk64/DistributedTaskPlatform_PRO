# Кореневий .env для docker-compose — скопіюй у .env і перевизнач
# (без .env docker-compose застосує дефолтні dev-значення)

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=distributed_platform

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Логування: LOG_JSON=true — JSON logs для машинного розбору
LOG_LEVEL=INFO
LOG_JSON=false

# CORS: кома-розділений список дозволених origin (для production — конкретні домени)
CORS_ORIGINS=*

# Auth/JWT: секрет обов'язково змінити для production
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Rate limiting: більш строгий ліміт для /auth/* (за IP), ширший — для всього API (per-user/per-IP)
# API-лімітер розподілений у Redis (Lua sliding window); фолбек на локальний in-process при недоступності Redis.
AUTH_RATE_LIMIT_MINUTES=1
AUTH_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_SECONDS=60
API_RATE_LIMIT_MAX=120
RATE_LIMIT_REDIS_ENABLED=true

# WebSocket-підключення: ліміт на користувача (Redis sliding window)
WS_CONNECT_LIMIT_MAX=20
WS_CONNECT_LIMIT_WINDOW_SECONDS=60

# Self-healing: повторна публікація queued-задач, що зависли довше цього часу
QUEUED_RECONCILE_SECONDS=60

# Outbox relay — період опитування БД у секундах
OUTBOX_POLL_SECONDS=2

# Максимальна кількість спроб для нових задач (за замовчуванням)
TASK_MAX_ATTEMPTS=3

# Таймаут виконання задачі у worker (секунди)
TASK_EXECUTION_TIMEOUT_SECONDS=60

# Ретраї: експоненціальний backoff
RETRY_BASE_SECONDS=1
RETRY_BACKOFF_FACTOR=2
RETRY_MAX_DELAY_SECONDS=300

# Retry-планувальник — період опитування ретраїв у секундах
RETRY_SCHEDULER_POLL_SECONDS=2

# Автоматичний DLQ-retry: dead-letter задачі повертаються в чергу за розкладом
DLQ_RETRY_ENABLED=true
DLQ_RETRY_INTERVAL_SECONDS=300
DLQ_RETRY_MAX_CYCLES=3

# Worker: heartbeat та детекція мертвих воркерів
WORKER_ID=worker-1
WORKER_HEARTBEAT_SECONDS=15
WORKER_HEARTBEAT_TIMEOUT_SECONDS=60
TASK_LEASE_SECONDS=60

# Redis: канал live-подій для дашборда (pub/sub). Вимикається через REDIS_EVENTS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_EVENTS_ENABLED=true
EVENTS_CHANNEL=task_platform.events